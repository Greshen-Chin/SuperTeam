# Hugging Face Spaces backend env template.
# Copy these keys into Space Settings -> Variables and Secrets.
# Do not commit real secret values.

# Runtime
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=info
FRONTEND_ORIGIN=https://vidchain.vercel.app
JWT_SECRET=

# Database
DATABASE_URL=
DIRECT_URL=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SKIP_TX_VERIFY=true
PLATFORM_WALLET_SECRET=

# Optional IPFS provider. Set one of these for real file pinning.
PINATA_JWT=
NFT_STORAGE_API_KEY=

# Optional admin / program config.
VIDCHAIN_PROGRAM_ID=
VIDCHAIN_PLATFORM_WALLET=
VIDCHAIN_ADMIN_WALLETS=
