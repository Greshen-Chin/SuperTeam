# Copy to .env.local and edit. .env.local is gitignored.
# Keys prefixed NEXT_PUBLIC_ are sent to the browser. All others are server-only.

# --- Public (browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_VIDCHAIN_PROGRAM_ID=
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_USE_MOCK_CHAIN=true

# --- Server-only ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=
NFT_STORAGE_API_KEY=
PINATA_JWT=
SOLANA_FEE_PAYER_SECRET=
SENTRY_DSN=
LOG_LEVEL=debug
