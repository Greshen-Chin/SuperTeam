# VidChain root .env example. Copy to .env.local and edit. .env.local is gitignored.
# Per-package .env.example files (frontend/.env.example, blockchain/.env.example, bot/.env.example)
# mirror the relevant subset for that workstream.

# =====================================================================
# Public (browser-exposed) — must use the NEXT_PUBLIC_ prefix in Next.js
# =====================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Filled after `anchor deploy`. See blockchain/instruction.md.
NEXT_PUBLIC_VIDCHAIN_PROGRAM_ID=

# Web3Auth (social login → embedded Solana wallet).
# Get a Client ID at https://dashboard.web3auth.io
#   Plug and Play → Solana → Sapphire Devnet (free, unlimited MAU on devnet).
# Whitelist http://localhost:3000 + your Vercel preview/prod URLs in the dashboard.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# Local dev mock flags. true = no real chain / no real backend.
# Production builds on vidchain.app FAIL if either is true (see frontend/src/lib/env.ts safety check).
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_USE_MOCK_CHAIN=true

# =====================================================================
# Server-only (never exposed to the browser)
# =====================================================================

# Supabase Postgres pooled connection (port 6543). Use the direct connection (5432)
# only for `prisma migrate dev`; runtime uses the pooled URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=

# IPFS pinning. Get a key at https://nft.storage (free) or https://pinata.cloud.
NFT_STORAGE_API_KEY=
PINATA_JWT=

# Devnet-only fee payer for the auto-airdrop endpoint. Base58 secret.
# DO NOT set this in production with a funded mainnet keypair.
SOLANA_FEE_PAYER_SECRET=

SENTRY_DSN=
LOG_LEVEL=debug

NODE_ENV=development
